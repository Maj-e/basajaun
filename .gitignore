# Secrets
.env

# Raw FIRMS / WorldPop data (heavy, not versioned)
data/raw/*
!data/raw/.gitkeep

# Python environment
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Live data: generated and published by .github/workflows/update-data.yml, never committed
web/data/processed/live/*
!web/data/processed/live/.gitkeep
