{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "episodes.schema.json",
  "title": "episodes.json — fire episodes the site can show, each with its own data folder and manifest",
  "type": "object",
  "required": ["updated_at", "default", "episodes"],
  "properties": {
    "updated_at": { "$ref": "common.schema.json#/$defs/datetimeUtc" },
    "default": { "type": "string", "description": "id of the episode shown first" },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "bbox", "start", "end", "dir", "manifest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "bbox": {
            "type": "array",
            "description": "west, south, east, north",
            "prefixItems": [
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 },
              { "type": "number", "minimum": -180, "maximum": 180 },
              { "type": "number", "minimum": -90, "maximum": 90 }
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "start": { "$ref": "common.schema.json#/$defs/date" },
          "end": { "$ref": "common.schema.json#/$defs/date" },
          "dir": { "type": "string", "pattern": "^[^/].*[^/]$", "description": "Data folder, relative to web/data/" },
          "manifest": { "type": "string", "pattern": "^(?!/).*manifest\\.json$", "description": "Relative to web/data/" },
          "skip": { "type": "array", "items": { "type": "string" }, "description": "Pipeline steps this episode doesn't run" }
        }
      }
    }
  }
}
